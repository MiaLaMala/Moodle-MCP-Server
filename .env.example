# Moodle MCP Server configuration
# Copy this file to .env and fill in your real values.
# Never commit .env to git.

# Required: base URL of your Moodle instance (no trailing slash).
# Example: https://lms.lernen.hamburg
MOODLE_URL=

# Auth option A — username + password (server exchanges them for a token via /login/token.php).
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Auth option B — a pre-issued Moodle Web Services token.
# If MOODLE_TOKEN is set, username/password are ignored.
MOODLE_TOKEN=

# Optional: where to persist the exchanged token so it is reused across server starts.
# Defaults to ~/.cache/moodle-mcp/token.json
# MOODLE_TOKEN_CACHE=

# Optional: request timeout in seconds (default 30).
# MOODLE_TIMEOUT=30

# Optional: where `download_course` stores files. Default: ~/Documents
# Tipp für Obsidian-User: setze es auf dein Vault, damit Downloads direkt indiziert werden.
# MOODLE_DOWNLOAD_ROOT=/Users/mia/Documents

# Optional: Audit-Log für Submissions (append-only, Text + Dateinamen, keine Inhalte).
# Default: ~/.moodle-mcp/submissions.log
# MOODLE_SUBMISSIONS_LOG=

# Optional: Speed-Tuning für download_course / push_to_open_notebook.
# Wie viele Dateien/Module gleichzeitig geladen werden (default 6) und die
# Retry-Policy für transiente Fehler (Timeouts, 429, 5xx) — Backoff ist
# exponentiell: retry_backoff_base * 2^Versuch + Jitter.
# MOODLE_MAX_CONCURRENCY=6
# MOODLE_RETRY_MAX_ATTEMPTS=4
# MOODLE_RETRY_BACKOFF_BASE=0.5

# Optional: Read-Only-Modus. Wenn true, wird das Tool `submit_assignment`
# gar nicht erst registriert — sinnvoll für Deployments, die niemals in
# Moodle schreiben sollen dürfen (z.B. geteilte/Server-Setups).
# MOODLE_READ_ONLY=false

# Optional: Push von Kursinhalten in eine selbst-gehostete Open-Notebook-
# Instanz (https://github.com/lfnovo/open-notebook), aktiviert das Tool
# `push_to_open_notebook`. MOODLE_OPEN_NOTEBOOK_PASSWORD nur nötig, falls
# dein Open-Notebook-Server mit OPEN_NOTEBOOK_PASSWORD-Schutz läuft.
# MOODLE_OPEN_NOTEBOOK_URL=https://notebook-api.example.dev
# MOODLE_OPEN_NOTEBOOK_PASSWORD=
